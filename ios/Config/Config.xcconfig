// WineSnap build configuration.
//
// Backend base URL, injected into Info.plist as WineSnapAPIURL.
// xcconfig treats "//" as a comment, so write URLs with "/$()/" in place of "//":
//   WINESNAP_API_URL = https:/$()/your-backend.up.railway.app
//
// The default targets a backend running on your Mac (works in the iOS Simulator).
// On a physical iPhone use your Mac's LAN IP or the deployed Railway URL.
WINESNAP_API_URL = http:/$()/localhost:8000

// Set your Apple Developer Team ID to run on a device.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.winesnap.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
